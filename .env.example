APP_NAME=Minizon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://minizon-api.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=minizon_db
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=array
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------
# FEDAPAY — Passerelle de paiement Mobile Money
# -----------------------------------------------------------------------
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxx
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxx
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxx
FEDAPAY_CALLBACK_URL=https://minizon-api.onrender.com/api/payments/callback
FEDAPAY_COMMISSION_RATE=10

# -----------------------------------------------------------------------
# FCM — Firebase Cloud Messaging HTTP v1 (push notifications)
# -----------------------------------------------------------------------
# 1. Firebase Console → Project Settings → Service accounts → Generate new private key
# 2. Placer le fichier JSON dans storage/app/ et indiquer le chemin complet ci-dessous
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS_PATH=/var/www/html/storage/app/firebase-service-account.json

# -----------------------------------------------------------------------
# ORS — OpenRouteService (calcul distances routières GPS)
# Clé gratuite : https://openrouteservice.org/dev/#/signup
# -----------------------------------------------------------------------
ORS_API_KEY=
